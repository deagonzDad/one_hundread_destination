---
import "@styles/global.css";
import "@fontsource/bebas-neue";
import Layout from "./Layout.astro";
import TitleComponent from "src/components/TitleComponent.astro";
import { TextAnimationMix } from "src/utils/transitions";
import igIcon from "@assets/svg/ig-icon.svg";
import linkedInIcon from "@assets/svg/linkedIn-icon.svg";
interface Props {
  title: string;
  description?: string;
}
const { title, description = "A journey to 100 dream destinations." } =
  Astro.props;
---

<Layout {title} {description}>
  <Fragment slot={"head"}></Fragment>
  <header>
    <div class="title--layer">
      <TitleComponent
        transitionName="titleText"
        transitionAnimate={TextAnimationMix}
      />
    </div>
    <nav>
      <div class="social-links">
        <a
          href="https://www.linkedin.com/in/anellvelazquez/"
          aria-label="LinkedIn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={linkedInIcon.src} alt="LinkedIn" />
        </a>
        <a
          href="https://www.instagram.com/anell.design/"
          aria-label="Instagram"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src={igIcon.src} alt="Instagram" />
        </a>
        <!-- Add more social media links here -->
      </div>
      <button class="nav-button" onclick="history.back()" aria-label="Go Back">
        <span class="material-icons">arrow_back</span>
      </button>
    </nav>
  </header>
  <main>
    <slot />
  </main>
</Layout>

<style>
  header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 1rem;
    justify-content: space-between;
    flex-shrink: 0;
  }
  main {
    flex-grow: 1;
    overflow: auto;
    scrollbar-color: black black;
    scrollbar-gutter: stable both-edges;
    scrollbar-width: thin;
  }
  nav {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .nav-button {
    background-color: #fff;
    color: #000;
    border: 1px solid #fff;
    padding: 0.5rem 1rem;
    border-radius: 5px;
    cursor: pointer;
    font-family: inherit;
    font-size: 1.6rem;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .nav-button:hover {
    background-color: #000;
    color: #fff;
  }

  .social-links {
    padding-left: 2rem;
    display: flex;
    gap: 1rem;
  }
  .social-links a {
    display: flex;
    color: #fff;
    text-decoration: none;
    font-size: 1.8rem;
    padding: 0.5rem;
    border: 1px solid transparent;
    border-radius: 5px;
    transition: border-color 0.3s;
    justify-content: center;
    align-items: center;
  }
  .social-links a:hover {
    border-color: #fff;
  }
  .social-links img {
    width: 24px;
    height: 24px;
    filter: invert(1);
  }
  .title--layer {
    width: 20%;
    display: flex;
    justify-content: center;
  }
  @media (max-width: 1000px) {
    header {
      flex-direction: column;
      gap: 1rem;
    }
    .title--layer {
      width: 100%;
    }
  }
</style>
