---
import TitleComponent from "src/components/TitleComponent.astro";
import Layout from "../layouts/Layout.astro";
import FullMapImg from "public/images/places/FullMap.webp";
import indexStyles from "@styles/index.module.css";
import {
  IndexLayoutAnimation,
  TextAnimationMix,
  // TextAnimationUpper,
} from "src/utils/transitions";
import BtnContinent from "src/components/BtnContinent.astro";
---

<Layout
  title="100 Destinations - Discover Your Next Adventure"
  description="Explore 100 of the world's most captivating destinations. Your ultimate travel guide to iconic landmarks, hidden gems, and unforgettable experiences."
>
  <div class={indexStyles["img-container"]}>
    <img
      class={indexStyles["img-map"]}
      src={FullMapImg.src}
      alt="World map background"
      transition:animate={IndexLayoutAnimation}
    />
    <div class={indexStyles["main-block"]}>
      <TitleComponent
        fontSize={10}
        transitionAnimate={TextAnimationMix}
        transitionName="titleText"
      />
      <BtnContinent href="continents/" text="Start Exploring" />
    </div>
  </div>
</Layout>
