---
import PointerContinent from "src/components/PointerContinent.astro";
import MainLayout from "src/layouts/MainLayout.astro";

const url = new URL(Astro.request.url);
const place = url.searchParams.get("place") ?? "";
const continent = url.searchParams.get("continent") ?? "";

const title = `Visit ${place} in ${continent} - 100 Destinations`;
const description = `Learn more about ${place}, a beautiful destination in ${continent}. Find travel tips, attractions, and more.`;
const image = `/images/places/image.webp`;
---

<MainLayout {title} {description} {image}>
  <place-component class="main-body">
    <div class="element-ctn ctn-left">
      <div class="main-card">
        <div class="place-image">
          <img src="/images/places/image.webp" id="placeImg" alt="continent" />
        </div>
        <div class="data-ctn" id="placesScroll"></div>
      </div>
    </div>
    <div class="element-ctn">
      <div class="card-main-ctn" id="selectorCityCtn"></div>
      <div class="img-ctn">
        <PointerContinent customId="continentImg" />
      </div>
    </div>
  </place-component>
</MainLayout>

<style>
  .main-body {
    display: flex;
    height: 100%;
    flex-direction: row;
  }
  .element-ctn {
    width: 50%;
    display: flex;
    flex-direction: column;
  }
  .ctn-left {
    align-items: center;
    justify-content: center;
    height: 100%;
  }
  .main-card {
    display: flex;
    background-color: white;
    height: 80%;
    width: 80%;
    border-radius: 60px;
    flex-direction: column;
    box-sizing: border-box;
    padding: 3rem;
  }
  .place-image {
    flex: 1;
    width: 100%;
    background-color: black;
    border-radius: 60px;
    overflow: hidden;
    position: relative;
  }
  #placeImg {
    width: 100%;
    height: 100%;
    top: 50%;
    left: 50%;
    position: absolute;
    object-fit: contain;
    transform: translate(-50%, -50%);
  }
  .data-ctn {
    flex: 1;
    display: flex;
    width: 100%;
    align-items: start;
    padding-top: 3rem;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10% 90%,
      transparent
    );
  }
  .place--image,
  .data--ctn {
    display: flex;
  }
  .card-main-ctn {
    display: flex;
    height: 15%;
    width: 100%;
  }
  .img-ctn {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 80%;
  }
  #continentImg {
    background-color: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  @media (max-width: 1000px) {
    .main-body {
      flex-direction: column;
    }
    .element-ctn {
      width: 100%;
    }
    .main-card {
      height: 40rem;
      overflow: hidden;
    }
    .card-main-ctn {
      height: 30%;
    }
  }
</style>

<script>
  import "@utils/PlaceWComponent";
</script>
